{
  "name": "resume",
  "homepage": "https://testacode.github.io/resume",
  "private": true,
  "version": "0.0.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:github": "vite build --base=/resume/",
